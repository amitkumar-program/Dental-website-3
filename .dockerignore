# This file specifies files and directories that should be ignored when building Docker/Container images.

# Git directory
.git/
.gitignore

# Node.js dependencies
node_modules/
**/node_modules/

# Local cache and IDE configs
.cache/
.local/
.vscode/
.idea/

# Large media or temporary files
Heo-video.mp4
sample-5s.mp4

# Build directories
dist/
**/dist/
build/
**/build/
tmp/
**/tmp/
out-tsc/
*.tsbuildinfo
